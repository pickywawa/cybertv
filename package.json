{
  "name": "cybertv",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "vite build && cap sync android",
    "android:run": "cap run android --live-reload --external",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "release": "node scripts/release.mjs",
    "desktop:build-main": "vite build -c vite.electron.config.ts",
    "desktop": "vite build && npm run desktop:build-main && electron .",
    "desktop:dist": "vite build && npm run desktop:build-main && electron-builder --mac --win --linux --publish never"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@tanstack/react-virtual": "^3.14.26",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.8",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "cyber": {
    "updateUrl": "https://github.com/pickywawa/cybertv/releases/latest/download/update.json",
    "minNativeCode": 9
  },
  "main": "dist-electron/main.cjs",
  "description": "Lecteur IPTV pour vos propres sources (Android, Android TV, iOS, ordinateur)",
  "author": "pickywawa",
  "build": {
    "appId": "app.cybertv.desktop",
    "productName": "CyberIPTV",
    "artifactName": "CyberIPTV-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release/desktop",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "electron/build/icon.png"
    }
  }
}
