{
  "name": "cybertv",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "vite build && cap sync android",
    "android:run": "cap run android --live-reload --external",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@tanstack/react-virtual": "^3.14.26",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "cyber": {
    "updateUrl": "https://github.com/pickywawa/cybertv/releases/latest/download/update.json",
    "minNativeCode": 6
  }
}
